# --- Client-side (safe to expose in the browser, used by src/lib/supabaseClient.js) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side only (used by api/contact.js, a Vercel serverless function) ---
# NEVER prefix this with VITE_ or it will be bundled into client-side code.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
